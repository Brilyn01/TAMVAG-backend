# ==============================================================================
# TAMVA Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# Server Configuration
PORT=
SPRING_PROFILES_ACTIVE=

# Database (PostgreSQL)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
TAMVA_DB_URL=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=

# Redis Cache
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# Security & JWT Secrets (Must be at least 256-bit long for HMAC-SHA256)
TAMVA_JWT_SECRET=
TAMVA_ACCESS_TOKEN_TTL_SECONDS=
TAMVA_USER_ACCESS_TOKEN_TTL_SECONDS=
TAMVA_REFRESH_TOKEN_TTL_DAYS=

# Webhook Encryption (Must be 32 characters)
TAMVA_WEBHOOK_ENCRYPTION_KEY=
TAMVA_WEBHOOK_MAX_ATTEMPTS=
TAMVA_WEBHOOK_INITIAL_RETRY_SECONDS=
TAMVA_WEBHOOK_MAX_RETRY_SECONDS=
TAMVA_WEBHOOK_STALE_DELIVERY_SECONDS=
TAMVA_WEBHOOK_POLL_INTERVAL_MS=

# Fraud & Risk Rules
TAMVA_RULESET_VERSION=

# Kafka (Optional)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
