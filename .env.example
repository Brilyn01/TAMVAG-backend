# ==============================================================================
# TAMVA Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database (PostgreSQL)
POSTGRES_DB=tamva
POSTGRES_USER=tamva_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tamva
SPRING_DATASOURCE_USERNAME=tamva_user
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Security & JWT Secrets (Must be at least 256-bit long for HMAC-SHA256)
TAMVA_JWT_SECRET=your_jwt_secret_key_here
TAMVA_ACCESS_TOKEN_TTL_SECONDS=3600
TAMVA_USER_ACCESS_TOKEN_TTL_SECONDS=900
TAMVA_REFRESH_TOKEN_TTL_DAYS=7

# Webhook Encryption (Must be 32 characters)
TAMVA_WEBHOOK_ENCRYPTION_KEY=your_32_char_webhook_key_here
TAMVA_WEBHOOK_MAX_ATTEMPTS=8
TAMVA_WEBHOOK_INITIAL_RETRY_SECONDS=30
TAMVA_WEBHOOK_MAX_RETRY_SECONDS=3600
TAMVA_WEBHOOK_STALE_DELIVERY_SECONDS=120
TAMVA_WEBHOOK_POLL_INTERVAL_MS=5000

# Fraud & Risk Rules
TAMVA_RULESET_VERSION=rules-2026.09.1

# Kafka (Optional)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
